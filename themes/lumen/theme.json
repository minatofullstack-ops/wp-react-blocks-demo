{
	"$schema": "https://schemas.wp.org/wp/6.8/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": false,
		"useRootPaddingAwareAlignments": true,
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"color": {
			"custom": false,
			"customDuotone": false,
			"customGradient": false,
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"duotone": [],
			"link": true,
			"palette": [
				{
					"slug": "base",
					"color": "#FFFFFF",
					"name": "ホワイト"
				},
				{
					"slug": "surface",
					"color": "#F3F6FB",
					"name": "サーフェス（薄グレー）"
				},
				{
					"slug": "primary-soft",
					"color": "#E8EEFC",
					"name": "プライマリ（淡）"
				},
				{
					"slug": "border",
					"color": "#DDE3ED",
					"name": "ボーダー"
				},
				{
					"slug": "muted",
					"color": "#4F5B6D",
					"name": "サブテキスト"
				},
				{
					"slug": "ink",
					"color": "#0E1A2B",
					"name": "インク（濃紺）"
				},
				{
					"slug": "primary",
					"color": "#1D4ED8",
					"name": "プライマリ（ブルー）"
				},
				{
					"slug": "accent",
					"color": "#FF8A4C",
					"name": "アクセント（オレンジ）"
				}
			],
			"gradients": [
				{
					"slug": "brand",
					"gradient": "linear-gradient(135deg, #0E1A2B 0%, #16307A 55%, #1D4ED8 100%)",
					"name": "ブランド（濃紺→ブルー）"
				},
				{
					"slug": "soft",
					"gradient": "linear-gradient(180deg, #F3F6FB 0%, #FFFFFF 100%)",
					"name": "ソフト（薄グレー→白）"
				}
			]
		},
		"layout": {
			"contentSize": "760px",
			"wideSize": "1200px"
		},
		"position": {
			"sticky": true
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{
					"slug": "card",
					"shadow": "0 18px 40px -26px rgba(14, 26, 43, 0.45)",
					"name": "カード"
				}
			]
		},
		"spacing": {
			"blockGap": true,
			"margin": true,
			"padding": true,
			"customSpacingSize": false,
			"defaultSpacingSizes": false,
			"units": [
				"px",
				"rem",
				"%",
				"vw",
				"vh"
			],
			"spacingSizes": [
				{
					"slug": "20",
					"size": "0.5rem",
					"name": "2XS"
				},
				{
					"slug": "30",
					"size": "1rem",
					"name": "XS"
				},
				{
					"slug": "40",
					"size": "1.5rem",
					"name": "S"
				},
				{
					"slug": "50",
					"size": "clamp(2rem, 1.5rem + 1.5vw, 3rem)",
					"name": "M"
				},
				{
					"slug": "60",
					"size": "clamp(3rem, 2.2rem + 2.5vw, 4.5rem)",
					"name": "L"
				},
				{
					"slug": "70",
					"size": "clamp(4rem, 2.8rem + 4vw, 7rem)",
					"name": "XL"
				},
				{
					"slug": "80",
					"size": "clamp(5rem, 3.4rem + 5vw, 9rem)",
					"name": "2XL"
				}
			]
		},
		"typography": {
			"customFontSize": false,
			"defaultFontSizes": false,
			"dropCap": false,
			"fluid": true,
			"fontStyle": true,
			"fontWeight": true,
			"letterSpacing": false,
			"lineHeight": false,
			"textDecoration": false,
			"textTransform": false,
			"writingMode": false,
			"fontFamilies": [
				{
					"slug": "body",
					"name": "Noto Sans JP（本文）",
					"fontFamily": "\"Noto Sans JP\", \"Hiragino Sans\", \"Hiragino Kaku Gothic ProN\", Meiryo, sans-serif"
				},
				{
					"slug": "inter",
					"name": "Inter（英数字）",
					"fontFamily": "Inter, \"Noto Sans JP\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/inter/inter-latin-wght-normal.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"size": "0.875rem",
					"name": "小",
					"fluid": false
				},
				{
					"slug": "medium",
					"size": "1rem",
					"name": "標準",
					"fluid": false
				},
				{
					"slug": "large",
					"size": "1.125rem",
					"name": "大",
					"fluid": {
						"min": "1.0625rem",
						"max": "1.25rem"
					}
				},
				{
					"slug": "x-large",
					"size": "1.5rem",
					"name": "特大",
					"fluid": {
						"min": "1.25rem",
						"max": "1.625rem"
					}
				},
				{
					"slug": "xx-large",
					"size": "2.25rem",
					"name": "見出し",
					"fluid": {
						"min": "1.625rem",
						"max": "2.5rem"
					}
				},
				{
					"slug": "display",
					"size": "3.5rem",
					"name": "ディスプレイ",
					"fluid": {
						"min": "2rem",
						"max": "3.75rem"
					}
				}
			]
		},
		"blocks": {
			"core/button": {
				"border": {
					"radius": false
				}
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--ink)"
		},
		"spacing": {
			"blockGap": "1.5rem",
			"padding": {
				"top": "0",
				"right": "clamp(1rem, 4vw, 2.5rem)",
				"bottom": "0",
				"left": "clamp(1rem, 4vw, 2.5rem)"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"fontWeight": "400",
			"lineHeight": "1.9",
			"letterSpacing": "0.02em"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"typography": {
						"textDecoration": "none"
					}
				},
				":focus": {
					"outline": {
						"color": "var(--wp--preset--color--primary)",
						"offset": "3px",
						"style": "solid",
						"width": "2px"
					}
				}
			},
			"heading": {
				"color": {
					"text": "inherit"
				},
				"typography": {
					"fontWeight": "700",
					"lineHeight": "1.45",
					"letterSpacing": "0.03em"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--display)",
					"lineHeight": "1.3"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)"
				}
			},
			"button": {
				"border": {
					"radius": "999px",
					"width": "2px",
					"style": "solid",
					"color": "transparent"
				},
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--base)"
				},
				"spacing": {
					"padding": {
						"top": "0.85rem",
						"right": "1.9rem",
						"bottom": "0.85rem",
						"left": "1.9rem"
					}
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)",
					"fontWeight": "700",
					"lineHeight": "1.5",
					"letterSpacing": "0.04em"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--ink)"
					},
					"border": {
						"color": "transparent"
					}
				},
				":focus": {
					"outline": {
						"color": "var(--wp--preset--color--accent)",
						"offset": "3px",
						"style": "solid",
						"width": "3px"
					}
				}
			},
			"caption": {
				"color": {
					"text": "var(--wp--preset--color--muted)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			}
		},
		"blocks": {
			"core/navigation": {
				"typography": {
					"fontSize": "0.9375rem",
					"fontWeight": "700"
				}
			},
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--inter)",
					"fontSize": "1.375rem",
					"fontWeight": "800",
					"letterSpacing": "0.02em"
				},
				"elements": {
					"link": {
						"color": {
							"text": "inherit"
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/post-title": {
				"elements": {
					"link": {
						"color": {
							"text": "inherit"
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--border)"
				}
			},
			"core/list": {
				"spacing": {
					"padding": {
						"left": "1.25em"
					}
				}
			},
			"core/button": {
				"variations": {
					"outline": {
						"border": {
							"color": "currentColor",
							"width": "2px",
							"style": "solid"
						},
						"color": {
							"background": "transparent",
							"text": "currentColor"
						}
					}
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "ヘッダー",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "フッター",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "page-landing",
			"title": "LP（ヘッダー簡易版）",
			"postTypes": [
				"page"
			]
		},
		{
			"name": "page-wide",
			"title": "全幅ページ（タイトルなし）",
			"postTypes": [
				"page"
			]
		}
	]
}
