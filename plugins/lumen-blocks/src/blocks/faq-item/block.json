{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "lumen/faq-item",
	"version": "1.0.0",
	"title": "FAQ項目",
	"category": "lumen",
	"icon": "editor-help",
	"description": "質問と回答のセット。回答には段落やリストを自由に追加できます。",
	"parent": [ "lumen/faq" ],
	"textdomain": "lumen-blocks",
	"attributes": {
		"question": {
			"type": "string",
			"default": ""
		},
		"openByDefault": {
			"type": "boolean",
			"default": false
		}
	},
	"supports": {
		"html": false,
		"reusable": false,
		"interactivity": true
	},
	"editorScript": "file:./index.js",
	"render": "file:./render.php"
}
