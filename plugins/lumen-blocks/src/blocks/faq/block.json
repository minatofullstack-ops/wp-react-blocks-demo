{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "lumen/faq",
	"version": "1.0.0",
	"title": "よくある質問（FAQ）",
	"category": "lumen",
	"icon": "editor-help",
	"description": "開閉できるFAQアコーディオン。キーボード操作・スクリーンリーダーに対応し、構造化データ（FAQPage）も出力できます。",
	"keywords": [ "faq", "質問", "Q&A", "アコーディオン" ],
	"textdomain": "lumen-blocks",
	"attributes": {
		"outputSchema": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"spacing": {
			"margin": [ "top", "bottom" ]
		},
		"interactivity": true
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScriptModule": "file:./view.js",
	"render": "file:./render.php"
}
