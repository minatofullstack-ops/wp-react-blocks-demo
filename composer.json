{
  "name": "minatofullstack-ops/wp-react-blocks-demo",
  "description": "PHP coding standards tooling for the Lumen theme and Lumen Blocks plugin.",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "require-dev": {
    "wp-coding-standards/wpcs": "^3.1",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "scripts": {
    "lint:php": "phpcs",
    "format:php": "phpcbf"
  }
}
