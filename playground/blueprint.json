{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "meta": {
    "title": "Lumen – WordPress React blocks demo",
    "description": "Installs the Lumen block theme and the Lumen Blocks plugin from the dist branch (built by the release workflow) and imports the demo content, with Japanese admin translations.",
    "author": "minatofullstack-ops",
    "categories": [
      "Block Theme",
      "Custom Blocks"
    ]
  },
  "landingPage": "/",
  "preferredVersions": {
    "php": "8.2",
    "wp": "latest"
  },
  "features": {
    "networking": true
  },
  "steps": [
    {
      "step": "login",
      "username": "admin",
      "password": "password"
    },
    {
      "step": "unzip",
      "zipFile": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/minatofullstack-ops/wp-react-blocks-demo/dist/wp-ja.zip"
      },
      "extractToPath": "/wordpress/wp-content/languages"
    },
    {
      "step": "setSiteOptions",
      "options": {
        "WPLANG": "ja",
        "timezone_string": "Asia/Tokyo",
        "date_format": "Y年n月j日",
        "time_format": "H:i"
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/minatofullstack-ops/wp-react-blocks-demo/dist/lumen-blocks.zip"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "installTheme",
      "themeData": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/minatofullstack-ops/wp-react-blocks-demo/dist/lumen.zip"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "wp-cli",
      "command": "wp lumen-demo import"
    },
    {
      "step": "runPHP",
      "code": "<?php require \"/wordpress/wp-load.php\"; update_user_meta( 1, $GLOBALS[\"wpdb\"]->get_blog_prefix() . \"persisted_preferences\", json_decode( \"{\\\"core/edit-post\\\":{\\\"welcomeGuide\\\":false},\\\"core/edit-site\\\":{\\\"welcomeGuide\\\":false,\\\"welcomeGuideStyles\\\":false,\\\"welcomeGuidePage\\\":false,\\\"welcomeGuideTemplate\\\":false},\\\"core\\\":{\\\"isComplementaryAreaVisible\\\":true},\\\"_modified\\\":\\\"2026-11-09T00:00:00.000Z\\\"}\", true ) );"
    }
  ]
}
