{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "meta": {
    "title": "Lumen – WordPress React blocks demo",
    "description": "Installs the Lumen block theme and the Lumen Blocks plugin from the dist branch (built by the release workflow) and imports the demo content.",
    "author": "minatofullstack-ops",
    "categories": [
      "Block Theme",
      "Custom Blocks"
    ]
  },
  "landingPage": "/",
  "preferredVersions": {
    "php": "8.2",
    "wp": "latest"
  },
  "features": {
    "networking": true
  },
  "steps": [
    {
      "step": "login",
      "username": "admin",
      "password": "password"
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/minatofullstack-ops/wp-react-blocks-demo/dist/lumen-blocks.zip"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "installTheme",
      "themeData": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/minatofullstack-ops/wp-react-blocks-demo/dist/lumen.zip"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "wp-cli",
      "command": "wp lumen-demo import"
    }
  ]
}
